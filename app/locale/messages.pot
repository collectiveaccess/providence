#: app/refineries/dateJoiner/dateJoinerRefinery.php:237
msgid "Two-column range"
msgstr "Ámbito de dos columnas"

#: app/refineries/dateJoiner/dateJoinerRefinery.php:238
msgid "Multi-column range"
msgstr "Ámbito multi-columnar"

#: app/refineries/dateJoiner/dateJoinerRefinery.php:239
msgid "Multi-column date"
msgstr "Fechas multi-columna"

#: app/refineries/dateJoiner/dateJoinerRefinery.php:241
msgid "Join mode"
msgstr "Modo de junta"

#: app/refineries/dateJoiner/dateJoinerRefinery.php:242
msgid ""
"Determines how dateJoiner joins date values together. Two-column range is "
"the default if mode is not specified."
msgstr ""
"Determina como dateJoiner junta valores de fecha. Ámbito de dos columnas es "
"el modo por defecto si otro modo no se especifica."

#: app/refineries/dateJoiner/dateJoinerRefinery.php:250
msgid "Date expression"
msgstr "Expresión de fecha"

#: app/refineries/dateJoiner/dateJoinerRefinery.php:251
msgid "Date expression (For Two-column range)"
msgstr "Expresión de fecha (para ámbitos de dos columnas)"

#: app/refineries/dateJoiner/dateJoinerRefinery.php:259
msgid "Date start"
msgstr "Fecha inicial"

#: app/refineries/dateJoiner/dateJoinerRefinery.php:260
msgid ""
"Maps the date from the data source that is the beginning of the conjoined "
"date range. (For Two-column range)."
msgstr ""
"Mapea la fecha de la fuente de datos que es el arranque del rango unido de "
"fechas. (Para rangos de dos columnas)"

#: app/refineries/dateJoiner/dateJoinerRefinery.php:268
msgid "Ignore start dates if they are today's date."
msgstr "Ignorar fecha de comienzo si son la fecha de hoy."

#: app/refineries/dateJoiner/dateJoinerRefinery.php:269
#: app/refineries/dateJoiner/dateJoinerRefinery.php:314
msgid ""
"Excel will sometimes return the present date for blank dates. Set this "
"option to treat them as blanks. (For Two-column range)."
msgstr ""
"Excel a veces retorna la fecha actual en lugar de fechas vacías. Asignar "
"esta opción para tratarlas como vacías. (Para rangos de dos columnas)."

#: app/refineries/dateJoiner/dateJoinerRefinery.php:277
msgid "Skip start date if expression"
msgstr "Saltar la fecha de comienzo si expresión"

#: app/refineries/dateJoiner/dateJoinerRefinery.php:278
msgid ""
"Omits start date from range if specified expression is true. (For Two-column "
"range)."
msgstr ""
"Omitir la fecha de comienzo de un rango de fechas si la expresión "
"especificada es cierta. (Para rangos de dos columnas)"

#: app/refineries/dateJoiner/dateJoinerRefinery.php:286
msgid "Skip start date if empty"
msgstr "Saltar la fecha de comienzo si está vacía."

#: app/refineries/dateJoiner/dateJoinerRefinery.php:287
msgid "Omits start date from range if empty. (For Two-column range)."
msgstr ""
"Omite la fecha de comienzo del rango de fechas si el campo está vacío. (Para "
"rangos de dos columnas)"

#: app/refineries/dateJoiner/dateJoinerRefinery.php:295
msgid "Skip start date replacement value"
msgstr "Fecha de sustición para fechas de comienzo saltadas"

#: app/refineries/dateJoiner/dateJoinerRefinery.php:296
msgid ""
"Value to replace start date with when start date is skipped. (For Two-column "
"range)."
msgstr ""
"Valor con el que reemplazar la fecha de comienzo cuando la fecha de comienzo "
"se ha saltado. (Para rangos de dos columnas)"

#: app/refineries/dateJoiner/dateJoinerRefinery.php:304
msgid "Date end"
msgstr "Fecha final"

#: app/refineries/dateJoiner/dateJoinerRefinery.php:305
msgid ""
"Maps the date from the data source that is the end of the conjoined date "
"range. (For Two-column range)"
msgstr ""
"Mapea la fecha de la fuente de datos que es el final del rango de fechas. "
"(Para rangos de dos columnas)"

#: app/refineries/dateJoiner/dateJoinerRefinery.php:313
msgid "Ignore end dates if they are today's date."
msgstr "Ignorar fechas finales que sean la fecha de hoy."

#: app/refineries/dateJoiner/dateJoinerRefinery.php:322
msgid "Skip end date if expression"
msgstr "Saltar la fecha final si expresión"

#: app/refineries/dateJoiner/dateJoinerRefinery.php:323
msgid ""
"Omits end date from range if specified expression is true. (For Two-column "
"range)."
msgstr ""
"Omite la fecha final de un intervalo si la expresión especificada es cierta "
"(para intervalos de 2 columnas)."

#: app/refineries/dateJoiner/dateJoinerRefinery.php:331
msgid "Skip end date if empty"
msgstr "Saltar la fecha final si está vacía"

#: app/refineries/dateJoiner/dateJoinerRefinery.php:332
msgid "Omits end date from range if it is empty. (For Two-column range)."
msgstr ""
"Omite la fecha final de un intervalo si está vacía (para intervalos de 2 "
"columnas)."

#: app/refineries/dateJoiner/dateJoinerRefinery.php:340
msgid "Skip end date replacement value"
msgstr "Valor de sustitución de fecha final si se salta"

#: app/refineries/dateJoiner/dateJoinerRefinery.php:341
msgid ""
"Value to replace end date with when end date is skipped. (For Two-column "
"range)."
msgstr ""
"Valor con el que sustituir la fecha final si dicha fecha final se salta "
"(para intervalos de 2 columnas)"

#: app/refineries/dateJoiner/dateJoinerRefinery.php:349
msgid "Date start day"
msgstr "Día de la fecha inicial"

#: app/refineries/dateJoiner/dateJoinerRefinery.php:350
