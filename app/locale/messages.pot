msgid "Relationship type"
msgstr "Tipo de relación"

#: app/models/ca_data_importer_items.php:590
msgid "Relationship type to use when linking to a related record."
msgstr "Tipo de relación que usar para enlazar un registro relacionado."

#: app/models/ca_data_importer_items.php:598
msgid "Convert newlines to HTML"
msgstr "Convertir saltos de línea a HTML"

#: app/models/ca_data_importer_items.php:599
msgid "Convert newline characters in text to HTML &lt;BR/&gt; tags."
msgstr ""
"Convertir los caracteres de salto de línea en el texto a etiquetas HTML "
"&lt;BR/&gt;."

#: app/models/ca_data_importer_items.php:607
msgid "Collapse multiple spaces"
msgstr "Colapsar espacios múltiples"

#: app/models/ca_data_importer_items.php:608
msgid "Convert multiple spaces to a single space."
msgstr "Convertir espacios múltiples a un solo espacio."

#: app/models/ca_data_importer_items.php:616
msgid "Force first to uppercase"
msgstr "Forzar la primera a mayúscula"

#: app/models/ca_data_importer_items.php:617
msgid "Force first letter of value to uppercase."
msgstr "Forzar la primera letra a mayúscula."

#: app/models/ca_data_importer_items.php:625
msgid "Force to uppercase"
msgstr "Forzar a mayúsculas"

#: app/models/ca_data_importer_items.php:626
msgid "Force value to uppercase."
msgstr "Forzar el valor a mayúsculas."

#: app/models/ca_data_importer_items.php:634
msgid "Force to lowercase"
msgstr "Forzar a minúsculas"

#: app/models/ca_data_importer_items.php:635
msgid "Force value to lowercase."
msgstr "Forzar el valor a minúsculas."

#: app/models/ca_data_importer_items.php:643
msgid "Use as single value"
msgstr "Usar como valor único"

#: app/models/ca_data_importer_items.php:644
msgid ""
"Force repeating values to be imported as a single value concatenated with "
"the specified delimiter."
msgstr ""
"Forzar que los valores múltiples sean importados como un valor único con los "
"valores concatenados con el delimitador especificado."

#: app/models/ca_data_importer_items.php:652
#: app/refineries/collectionHierarchyBuilder/collectionHierarchyBuilderRefinery.php:135
