#: app/refineries/dateJoiner/dateJoinerRefinery.php:385
msgid "Date end month"
msgstr "Mes de la fecha final"

#: app/refineries/dateJoiner/dateJoinerRefinery.php:386
msgid ""
"Maps the month value for the end date from the data source. (For Multi-"
"column range)"
msgstr ""
"Mapea el valor del mes para la fecha final en la fuente de datos. (Para "
"intervalos multi-columna)"

#: app/refineries/dateJoiner/dateJoinerRefinery.php:394
msgid "Date end year"
msgstr "Año de la fecha final"

#: app/refineries/dateJoiner/dateJoinerRefinery.php:395
msgid ""
"Maps the year value for the end date from the data source. (For Multi-column "
"range)"
msgstr ""
"Mapea el valor del año para la fecha final en la fuente de datos. (Para "
"intervalos multi-columna)"

#: app/refineries/dateJoiner/dateJoinerRefinery.php:403
msgid "Date day"
msgstr "Día de la fecha"

#: app/refineries/dateJoiner/dateJoinerRefinery.php:404
msgid ""
